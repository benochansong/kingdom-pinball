# Client build-time public URL. Use wss:// for Internet deployment.
VITE_GAME_SERVER_URL=ws://127.0.0.1:8787/ws
SERVER_PORT=8787
SERVER_HOST=127.0.0.1
DATABASE_URL=./data/online.sqlite
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5176
MAX_ROOMS=5
MAX_PLAYERS=32
# Production: configure the actual deployment origin; no fallback domain.
APP_DOMAIN=
APP_ORIGIN=
# Optional admin metrics credential. Generate a long random value; never expose via VITE_.
ADMIN_TOKEN=
# Sessions use cryptographically random opaque tokens and store SHA-256 hashes.
# No client-visible signing secret or password database is needed.
